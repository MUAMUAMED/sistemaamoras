# Fullstack Dockerfile para EasyPanel
# Frontend React + Backend Node.js com Nginx

# Stage 1: Build Frontend
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

# Copiar package files do frontend
COPY frontend/package*.json ./

# Instalar dependências do frontend
RUN npm ci --legacy-peer-deps --prefer-offline --no-audit && \
    npm cache clean --force

# Copiar código fonte do frontend
COPY frontend/ ./

# Build Arguments
ARG REACT_APP_API_URL=/api
ARG VITE_API_URL=/api
ARG NODE_ENV=production

# Configurar variáveis de ambiente para build (Vite)
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV VITE_API_URL=$VITE_API_URL
ENV NODE_ENV=$NODE_ENV
ENV GENERATE_SOURCEMAP=false
ENV INLINE_RUNTIME_CHUNK=false

# Build da aplicação frontend com Vite
RUN npm run build

# Stage 2: Build Backend
FROM node:20-alpine AS backend-builder

WORKDIR /app/backend

# Copiar package files do backend
COPY backend/package*.json ./

# Instalar dependências do backend
RUN npm ci --legacy-peer-deps --prefer-offline --no-audit && \
    npm cache clean --force

# Copiar código fonte do backend
COPY backend/ ./

# Pular build por enquanto - usar ts-node

# Stage 3: Production
FROM node:20-alpine AS production

# Instalar nginx e dependências
RUN apk add --no-cache nginx curl supervisor

# Criar diretórios necessários
RUN mkdir -p /app /var/log/supervisor /run/nginx /etc/supervisor/conf.d

WORKDIR /app

# Copiar build do frontend (Vite usa 'dist' em vez de 'build')
COPY --from=frontend-builder /app/frontend/dist /var/www/html

# Copiar código do backend (sem build)
COPY --from=backend-builder /app/backend/src ./backend
COPY --from=backend-builder /app/backend/package*.json ./
COPY --from=backend-builder /app/backend/prisma ./prisma
COPY --from=backend-builder /app/backend/node_modules ./node_modules

# Instalar ts-node para execução direta
RUN npm install -g ts-node typescript

# Gerar cliente Prisma
RUN npx prisma generate

# Configurar nginx
RUN echo 'events { worker_connections 1024; } \
http { \
    include /etc/nginx/mime.types; \
    default_type application/octet-stream; \
    \
    upstream backend { \
        server 127.0.0.1:3001; \
    } \
    \
    server { \
        listen 80; \
        server_name _; \
        root /var/www/html; \
        index index.html; \
        \
        # Frontend - SPA routing \
        location / { \
            try_files $uri $uri/ /index.html; \
        } \
        \
        # Backend API \
        location /api/ { \
            proxy_pass http://backend/; \
            proxy_set_header Host $host; \
            proxy_set_header X-Real-IP $remote_addr; \
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
            proxy_set_header X-Forwarded-Proto $scheme; \
        } \
        \
        # Health check \
        location /health { \
            access_log off; \
            return 200 "healthy"; \
            add_header Content-Type text/plain; \
        } \
    } \
}' > /etc/nginx/nginx.conf

# Copiar configuração do supervisor
COPY frontend/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Build arguments para runtime
ARG DATABASE_URL
ARG JWT_SECRET=your-super-secret-jwt-key-change-in-production
ARG CORS_ORIGINS=*

# Variáveis de ambiente
ENV DATABASE_URL=$DATABASE_URL
ENV JWT_SECRET=$JWT_SECRET
ENV CORS_ORIGINS=$CORS_ORIGINS
ENV NODE_ENV=production
ENV PORT=3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Expor porta
EXPOSE 80

# Comando de inicialização
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
