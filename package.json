{
  "name": "amoras-capital-system",
  "version": "1.0.0",
  "description": "Sistema completo de CRM e ERP para Amoras Capital",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm start",
    "build:fullstack": "docker build -t amoras-capital-fullstack .",
    "build:fullstack:prod": "docker build --build-arg REACT_APP_API_URL=/api --build-arg VITE_API_URL=/api -t amoras-capital-fullstack:latest .",
    "docker:fullstack": "docker build -f Dockerfile -t amoras-capital-fullstack ."
  },
  "keywords": [
    "crm",
    "erp",
    "amoras-capital",
    "typescript",
    "react",
    "nodejs"
  ],
  "author": "Amoras Capital",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
