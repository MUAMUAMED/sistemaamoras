# ============================================
# Frontend - Variáveis de Ambiente para Build
# ============================================
# Use estas variáveis ao fazer o build do frontend
# Exemplo: docker build --build-arg VITE_API_URL="/api" ...

# URL da API Backend
# Use "/api" se o frontend e backend estiverem no mesmo domínio (proxy reverso)
# Use "https://api.seudominio.com/api" se estiverem em domínios diferentes
VITE_API_URL=/api
REACT_APP_API_URL=/api

# Timeout das requisições (em milissegundos)
REACT_APP_API_TIMEOUT=30000
VITE_API_TIMEOUT=30000

# Ambiente
NODE_ENV=production
GENERATE_SOURCEMAP=false

# Build otimizations
INLINE_RUNTIME_CHUNK=false 