# ============================================
# Variáveis de Ambiente - Full-Stack
# ============================================
# Copie este arquivo para .env e configure as variáveis

# ============================================
# OBRIGATÓRIAS
# ============================================

# Banco de Dados PostgreSQL
# Formato: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://amoras_user:SENHA_SEGURA@localhost:5432/amoras_capital"

# JWT Secret (mínimo 32 caracteres)
JWT_SECRET="seu_jwt_secret_super_secreto_aqui_min_32_chars_production_2024"

# ============================================
# OPCIONAIS (com defaults)
# ============================================

# Ambiente
NODE_ENV="production"

# Porta interna do backend (não exposta externamente)
PORT=3001

# Porta do Nginx (exposta externamente)
NGINX_PORT=80

# Modo Full-Stack (define comportamento do backend)
FULLSTACK_MODE=true

# URL da aplicação (para logs e referências)
APP_URL="https://app.seudominio.com"

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# ============================================
# LOGS
# ============================================

LOG_LEVEL="info"

# ============================================
# UPLOADS
# ============================================

UPLOAD_DIR="/app/backend/uploads"
MAX_FILE_SIZE=5242880

# ============================================
# INTEGRAÇÕES OPCIONAIS
# ============================================

# Chatwoot (Opcional)
CHATWOOT_URL=""
CHATWOOT_TOKEN=""

# N8N Webhook (Opcional)
N8N_WEBHOOK_URL=""

# Mercado Pago (Opcional)
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""

# ============================================
# SISTEMA
# ============================================

COMPANY_NAME="Amoras Capital"
SALE_NUMBER_PREFIX="AC"

# ============================================
# BUILD ARGUMENTS (usados durante docker build)
# ============================================
# Estas variáveis são usadas no build do frontend
# Defina via --build-arg durante o build

# REACT_APP_API_URL=/api
# VITE_API_URL=/api

