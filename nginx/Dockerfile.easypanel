# Nginx Dockerfile para EasyPanel
# Proxy reverso otimizado

FROM nginx:1.25-alpine

# Instalar curl para health check
RUN apk add --no-cache curl

# Remover configuração padrão
RUN rm -f /etc/nginx/conf.d/default.conf

# Criar configuração dinâmica
COPY nginx.easypanel.conf /etc/nginx/nginx.conf

# Copiar script de configuração
COPY configure-nginx.sh /docker-entrypoint.d/50-configure-nginx.sh
RUN chmod +x /docker-entrypoint.d/50-configure-nginx.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
